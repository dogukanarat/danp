# pkg-config file for Danp
# This file allows other projects to discover Danp using pkg-config

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
# Use relative paths for better relocatability
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: @PROJECT_NAME@
Description: @PROJECT_DESCRIPTION@
Version: @PROJECT_VERSION@
URL: https://github.com/dogukanarat/danp

# Libraries to link against
# Add any additional libraries required by Danp here
# Example: Libs: -L${libdir} -ldanp -lm -lpthread
Libs: -L${libdir} -ldanp

# Private libraries only needed when linking statically
Libs.private:

# Include directories
Cflags: -I${includedir}

# Dependencies
Requires:
Requires.private:
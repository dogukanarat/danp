@PACKAGE_INIT@

# ==============================================================================
# scaffold_project CMake Package Configuration File
# ==============================================================================
# This file is used by find_package(Danp) to locate and configure
# the Danp library for use in other CMake projects.

# ==============================================================================
# Package Version Information
# ==============================================================================
set(Danp_VERSION "@PROJECT_VERSION@")
set(Danp_VERSION_MAJOR "@PROJECT_VERSION_MAJOR@")
set(Danp_VERSION_MINOR "@PROJECT_VERSION_MINOR@")
set(Danp_VERSION_PATCH "@PROJECT_VERSION_PATCH@")

# ==============================================================================
# Dependencies
# ==============================================================================
# Find and configure any dependencies that scaffold_project requires
# Add dependencies here as needed, for example:
# find_dependency(SomePackage REQUIRED)

include(CMakeFindDependencyMacro)

# Note: Standard C library dependencies (like math library) are handled
# automatically by CMake and don't need to be listed here

# Example dependency declarations (uncomment and modify as needed):
# find_dependency(Threads)
# find_dependency(OpenSSL REQUIRED COMPONENTS SSL Crypto)

# ==============================================================================
# Component Support
# ==============================================================================
# Supported components for this package
set(_Danp_supported_components Runtime Development)

# Validate requested components
foreach(_comp ${Danp_FIND_COMPONENTS})
    if(NOT _comp IN_LIST _Danp_supported_components)
        set(Danp_FOUND False)
        set(Danp_NOT_FOUND_MESSAGE "Unsupported component: ${_comp}")
    endif()
endforeach()

# ==============================================================================
# Import Targets
# ==============================================================================
# Include the targets file generated during installation
# This file defines the Danp::Danp target
if(NOT TARGET Danp::Danp)
    include("${CMAKE_CURRENT_LIST_DIR}/DanpTargets.cmake")
endif()

# Verify that the main library target was successfully imported
if(NOT TARGET Danp::Danp)
    set(Danp_FOUND False)
    set(Danp_NOT_FOUND_MESSAGE "Target Danp::Danp not found")
endif()

# ==============================================================================
# Package Variables
# ==============================================================================
# Set convenience variables for downstream projects
set(Danp_LIBRARIES Danp::Danp)
set(Danp_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

# Legacy variables for compatibility (not recommended for new projects)
set(scaffold_project_LIBRARIES ${Danp_LIBRARIES})
set(scaffold_project_INCLUDE_DIRS ${Danp_INCLUDE_DIRS})

# ==============================================================================
# Finalization
# ==============================================================================
# Validate that all required components are available
check_required_components(Danp)
